# SONORA Music Intelligence Engine — Environment Configuration
# Copy to .env for local development. Never commit real secrets.

MUSIC_ENGINE_ENV=development
MUSIC_ENGINE_HOST=0.0.0.0
MUSIC_ENGINE_PORT=8000
MUSIC_ENGINE_LOG_LEVEL=INFO
MUSIC_ENGINE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Audio ingestion & processing limits
MUSIC_ENGINE_MAX_FILE_SIZE_BYTES=104857600
MUSIC_ENGINE_MAX_DURATION_SECONDS=900
MUSIC_ENGINE_MAX_CONCURRENT_JOBS_PER_USER=3
MUSIC_ENGINE_TEMP_DIR=/tmp/sonora-music-engine
MUSIC_ENGINE_LOCAL_STORAGE_DIR=/tmp/sonora-local-storage

# Storage backend: "local" or "supabase"
MUSIC_ENGINE_STORAGE_BACKEND=local

# Job persistence backend: "memory" or "supabase"
MUSIC_ENGINE_JOB_REPOSITORY_BACKEND=memory

# Background queue backend: "in_process" (dev/tests only) or "arq" (production Valkey/Redis worker)
MUSIC_ENGINE_QUEUE_BACKEND=in_process
# Valkey or Redis connection URL (supports redis:// and rediss://; never commit real credentials)
MUSIC_ENGINE_REDIS_URL=
MUSIC_ENGINE_ARQ_QUEUE_NAME=sonora:music-jobs

# Dedicated ARQ worker tuning, retries, timeouts, and restart recovery
MUSIC_ENGINE_WORKER_MAX_JOBS=4
MUSIC_ENGINE_JOB_TIMEOUT_SECONDS=600
MUSIC_ENGINE_JOB_MAX_RETRIES=3
MUSIC_ENGINE_JOB_RETRY_BACKOFF_SECONDS=5
MUSIC_ENGINE_CANCEL_SIGNAL_TTL_SECONDS=86400
MUSIC_ENGINE_STALE_WORKSPACE_MAX_AGE_SECONDS=3600
MUSIC_ENGINE_STALE_JOB_TIMEOUT_SECONDS=900
# Threshold before a job stuck in `queued` is verified against ARQ/Valkey and recovered if orphaned.
# Keep this above normal peak queue wait time; jobs still pending in ARQ are never failed.
MUSIC_ENGINE_STALE_QUEUED_JOB_TIMEOUT_SECONDS=600

# FluidSynth & verified SoundFont synthesis (keep soundfonts outside user upload paths)
FLUIDSYNTH_BIN=fluidsynth
MUSIC_ENGINE_SOUNDFONT_DIR=/usr/share/sounds/sf3
MUSIC_ENGINE_SOUNDFONT_PATH=
MUSIC_ENGINE_FLUIDSYNTH_TIMEOUT_SECONDS=180
MUSIC_ENGINE_FLUIDSYNTH_GAIN=0.7
MUSIC_ENGINE_SYNTHESIS_SAMPLE_RATE_HZ=44100

# Run 3 mixing, loudness normalization (pyloudnorm), true-peak ceiling, and export defaults
MUSIC_ENGINE_MASTER_TARGET_LUFS=-14.0
MUSIC_ENGINE_MASTER_TRUE_PEAK_CEILING_DBTP=-1.0
MUSIC_ENGINE_MASTER_MAX_LIMITING_DB=3.5
MUSIC_ENGINE_DEFAULT_VOCAL_GAIN_DB=0.0
MUSIC_ENGINE_DEFAULT_ACCOMPANIMENT_GAIN_DB=-4.5
MUSIC_ENGINE_EXPORT_WAV_BIT_DEPTH=16
MUSIC_ENGINE_EXPORT_MP3_BITRATE_KBPS=320
MUSIC_ENGINE_EXPORT_TIMEOUT_SECONDS=120

# Supabase integration (server-side only; never expose service_role key to frontend)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
# JWT verification mode:
#   - "auto" (default): verifies HS256 locally if SUPABASE_JWT_SECRET is set, and delegates
#     asymmetric Supabase signing algorithms (ES256/RS256/PS256/EdDSA) to GET /auth/v1/user.
#   - "remote": always verifies tokens via Supabase Auth GET /auth/v1/user (recommended for asymmetric keys).
#   - "hs256": enforces local HS256 verification using SUPABASE_JWT_SECRET only.
SUPABASE_JWT_VERIFICATION_MODE=auto
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_AUDIO_BUCKET=sonora-audio
SUPABASE_JOBS_TABLE=processing_jobs
SUPABASE_ASSETS_TABLE=audio_assets
